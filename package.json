{
  "name": "toolx",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:extension": "wxt",
    "build": "npm run typecheck && npm run build:web && npm run build:extension",
    "build:web": "vite build",
    "build:extension": "wxt build",
    "zip": "wxt zip",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:ui": "playwright test",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@radix-ui/react-select": "^2.3.7",
    "diff": "^8.0.2",
    "lossless-json": "^4.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@wxt-dev/module-react": "^1.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.0",
    "wxt": "^0.21.4"
  }
}
